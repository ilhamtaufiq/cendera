---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
---
<BaseLayout title="Halaman tidak ditemukan" description="Halaman yang Anda cari tidak ditemukan." noindex>
  <section class="relative isolate overflow-hidden">
    <div class="hex-pattern hex-mask animate-drift absolute inset-0 -z-10 opacity-30" aria-hidden="true"></div>
    <div class="container-site grid min-h-[75vh] items-center gap-12 py-20 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Error 404</p>
        <h1 class="mt-5 font-display text-5xl font-bold leading-tight sm:text-6xl">Jalurnya buntu.</h1>
        <p class="mt-5 max-w-md text-lg text-fg-muted">Seperti labirin di logo kami, kadang ada jalur yang tidak berujung. Halaman yang Anda cari mungkin sudah dipindahkan atau tidak pernah ada.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/" class="btn btn-primary"><Icon name="house" class="size-4" /> Kembali ke beranda</a>
          <a href="/blog" class="btn btn-secondary">Baca blog</a>
          <a href="/proyek" class="btn btn-ghost">Lihat proyek</a>
        </div>
      </div>
      <div class="relative mx-auto flex items-center justify-center" aria-hidden="true">
        <Logo variant="outline" class="maze h-[22rem] text-accent" />
        <span class="absolute font-display text-[7rem] font-bold text-fg/90 mix-blend-difference">404</span>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  /* stroke-dasharray/offset diwariskan ke path di dalam <use> */
  .maze { stroke-dasharray: 60 30; animation: dash 8s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -900; } }
</style>
