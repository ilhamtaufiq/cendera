---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/ui/Icon.astro';
import { getJobs } from '@/lib/content';
import { CONTACT } from '@/data/site';
const jobs = await getJobs();
---
<BaseLayout title="Karier" image="/og/pages/karier.png" description="Bergabung dengan Cendera: lowongan engineer, desainer, dan kreator konten.">
  <PageHeader eyebrow="Karier" title="Tumbuh bersama Cendera"
    lead="Kami mencari orang-orang yang teliti, suka belajar, dan peduli pada pengguna. Tim kecil, dampak besar." />
  <section class="container-site py-12 lg:py-16" aria-label="Daftar lowongan">
    {jobs.length === 0 ? (
      <p class="card p-10 text-center text-fg-muted">Belum ada lowongan terbuka. Kirim CV Anda ke <a class="text-accent-ink underline" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.</p>
    ) : (
      <ul class="space-y-4">
        {jobs.map((j) => (
          <li class="card card-hover">
            <a href={`/karier/${j.id}`} class="flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="font-display text-xl font-semibold">{j.data.title}</h2>
                <p class="mt-1 text-fg-muted">{j.data.summary}</p>
                <div class="mt-3 flex flex-wrap gap-2 text-xs">
                  <span class="chip">{j.data.type}</span>
                  <span class="chip"><Icon name="map-pin" class="size-3" />{j.data.location}</span>
                  <span class:list={['chip', j.data.open && 'chip-accent']}>{j.data.open ? 'Dibuka' : 'Ditutup'}</span>
                </div>
              </div>
              <span class="inline-flex items-center gap-1 text-sm font-semibold text-accent-ink">Detail <Icon name="arrow-right" class="size-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
