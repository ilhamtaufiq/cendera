---
/**
 * Ikon merek (Simple Icons) untuk stack teknologi & media sosial.
 * Bila slug tidak tersedia, tampil monogram (huruf awal).
 */
import * as si from 'simple-icons';

interface Props {
  slug: string;
  name?: string;
  class?: string;
  colored?: boolean;
}
const { slug, name = slug, class: className = 'size-5', colored = false } = Astro.props;

// LinkedIn tidak tersedia di Simple Icons → path manual (glyph "in" standar).
const LINKEDIN = 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z';

const all = Object.values(si as Record<string, any>).filter((i) => i && typeof i === 'object' && 'slug' in i);
const icon = slug === 'linkedin' ? { path: LINKEDIN, hex: '0A66C2' } : all.find((i) => i.slug === slug);
const initials = name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
{icon ? (
  <svg viewBox="0 0 24 24" class={className} aria-hidden="true" focusable="false" fill={colored ? `#${icon.hex}` : 'currentColor'}>
    <path d={icon.path} />
  </svg>
) : (
  <svg viewBox="0 0 24 24" class={className} aria-hidden="true" focusable="false">
    <path d="M12 1.5 21.1 6.75v10.5L12 22.5 2.9 17.25V6.75z" fill="none" stroke="currentColor" stroke-width="1.5" />
    <text x="12" y="15.5" text-anchor="middle" font-size="8.5" font-weight="700" fill="currentColor" font-family="ui-monospace, monospace">{initials}</text>
  </svg>
)}
