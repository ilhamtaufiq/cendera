---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  id?: string;
  as?: 'h1' | 'h2';
}
const { eyebrow, title, lead, align = 'left', id, as: Tag = 'h2' } = Astro.props;
---
<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  <p class:list={['eyebrow', align === 'center' && 'justify-center']}>{eyebrow}</p>
  <Tag id={id} class="mt-4 font-display text-3xl font-bold leading-tight sm:text-4xl lg:text-[2.75rem]">{title}</Tag>
  {lead && <p class="mt-4 text-base leading-relaxed text-fg-muted sm:text-lg">{lead}</p>}
  <slot />
</div>
