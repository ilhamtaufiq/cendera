---
/**
 * <head>: meta dasar, canonical, Open Graph, Twitter Card, JSON-LD, favicon, RSS, analitik opsional.
 */
import { SITE, CONTACT, SOCIALS } from '@/data/site';
import { cleanPath } from '@/lib/url';

export interface SeoProps {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  /** JSON-LD tambahan khusus halaman (Article, CreativeWork, BreadcrumbList, ...). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  imageAlt = `${SITE.name} — ${SITE.tagline}`,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props as SeoProps;

const fullTitle = title ? `${title} · ${SITE.name}` : SITE.homeTitle;
// URL bersih tanpa ".html" (lihat src/lib/url.ts)
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
const ogImage = new URL(image, Astro.site).href;
const ogImageType = image.endsWith('.png') ? 'image/png' : image.endsWith('.webp') ? 'image/webp' : 'image/jpeg';
const a = CONTACT.address;

// Organization + ProfessionalService (bisnis lokal) → membantu tampil di pencarian lokal Cianjur.
const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': new URL('/#organization', Astro.site).href,
  name: SITE.legalName,
  alternateName: SITE.name,
  url: Astro.site?.href,
  logo: new URL(SITE.logo, Astro.site).href,
  image: new URL(SITE.ogImage, Astro.site).href,
  description: SITE.description,
  foundingDate: String(SITE.foundingYear),
  email: CONTACT.email,
  telephone: `+${CONTACT.whatsapp}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: a.street,
    addressLocality: `${a.village}, ${a.district}, ${a.city}`,
    addressRegion: a.region,
    postalCode: a.postalCode,
    addressCountry: a.country,
  },
  hasMap: CONTACT.mapUrl,
  areaServed: [{ '@type': 'AdministrativeArea', name: 'Kabupaten Cianjur' }, { '@type': 'Country', name: 'Indonesia' }],
  knowsAbout: SITE.keywords,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: CONTACT.email,
    telephone: `+${CONTACT.whatsapp}`,
    availableLanguage: ['id', 'en'],
    areaServed: 'ID',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '13:00' },
  ],
  sameAs: SOCIALS.map((s) => s.href),
};
const ldList = [organization, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];

const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="author" content={author ?? SITE.name} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={SITE.themeColor} />
<meta name="color-scheme" content="dark light" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={`Blog ${SITE.name}`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<!-- i18n: saat versi Inggris tersedia, tambahkan <link rel="alternate" hreflang="en" ...> -->
<link rel="alternate" hreflang="id" href={canonical.href} />
<link rel="alternate" hreflang="x-default" href={canonical.href} />
<meta name="geo.region" content="ID-JB" />
<meta name="geo.placename" content={`${a.city}, ${a.region}`} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="id_ID" />
<meta property="og:title" content={title ?? fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{author && <meta property="article:author" content={author} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{ldList.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

{cfBeacon && (
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeacon })} />
)}
{umamiSrc && umamiId && <script defer src={umamiSrc} data-website-id={umamiId} />}
