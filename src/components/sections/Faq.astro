---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { faq } from '@/data/home.id';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container-site grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <SectionHeading id="faq-title" eyebrow="FAQ" title="Pertanyaan yang sering diajukan."
        lead="Tidak menemukan jawabannya? Kirim pertanyaan Anda lewat form kontak atau WhatsApp." />
    </div>
    <div class="space-y-3 lg:col-span-8">
      {faq.map((f, i) => (
        <details class="faq card group" data-reveal style={`--reveal-delay:${(i % 4) * 60}ms`} name="faq">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-5 font-display text-[1.05rem] font-semibold sm:p-6">
            {f.q}
            <span class="faq-icon flex size-8 shrink-0 items-center justify-center rounded-lg border border-border text-fg-muted transition">
              <Icon name="plus" class="size-4" />
            </span>
          </summary>
          <p class="px-5 pb-6 leading-relaxed text-fg-muted sm:px-6">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>
<style>
  .faq summary::-webkit-details-marker { display: none; }
  .faq[open] { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .faq[open] .faq-icon { transform: rotate(45deg); border-color: var(--accent); color: var(--accent-ink); }
  .faq::details-content { transition: height 0.3s ease, content-visibility 0.3s allow-discrete; height: 0; overflow: clip; }
  .faq[open]::details-content { height: auto; }
  @supports (interpolate-size: allow-keywords) { .faq { interpolate-size: allow-keywords; } }
</style>
