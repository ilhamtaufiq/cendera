---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/Logo.astro';
import { about } from '@/data/home.id';
---
<section id="tentang" class="section" aria-labelledby="tentang-title">
  <div class="container-site grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <SectionHeading id="tentang-title" eyebrow="Tentang Cendera" title="Presisi seorang insinyur, kepekaan seorang kreator." />
      <div class="mt-6 space-y-4 text-fg-muted leading-relaxed" data-reveal>
        {about.story.map((p) => <p>{p}</p>)}
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="card p-6" data-reveal>
          <p class="eyebrow">Visi</p>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-fg">{about.vision}</p>
        </div>
        <div class="card p-6" data-reveal style="--reveal-delay:80ms">
          <p class="eyebrow">Misi</p>
          <ul class="mt-3 space-y-2 text-[0.95rem] text-fg-muted">
            {about.mission.map((m) => <li class="flex gap-2"><Icon name="chevron-right" class="mt-1 size-4 shrink-0 text-accent-ink" />{m}</li>)}
          </ul>
        </div>
      </div>
    </div>
    <div class="relative lg:col-span-6">
      <Logo variant="outline" class="pointer-events-none absolute right-0 top-0 hidden h-full text-accent opacity-[0.06] lg:block" />
      <h3 class="font-mono text-xs uppercase tracking-[0.14em] text-fg-subtle" data-reveal>Nilai yang kami pegang</h3>
      <ul class="relative mt-6 grid gap-4 sm:grid-cols-2">
        {about.values.map((v, i) => (
          <li class="card card-hover p-6" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <Icon name={v.icon} class="size-6 text-accent-ink" />
            <h4 class="mt-5 font-display text-lg font-semibold">{v.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{v.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
