---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { process } from '@/data/home.id';
---
<section id="proses" class="section" aria-labelledby="proses-title">
  <div class="container-site">
    <SectionHeading id="proses-title" eyebrow="Proses Kerja" title="Lima langkah, tanpa kejutan."
      lead="Kami bekerja terbuka dan bertahap. Anda selalu tahu apa yang sedang dikerjakan, apa berikutnya, dan kenapa." />
    <ol class="timeline relative mt-16 grid gap-10 lg:grid-cols-5 lg:gap-6">
      {process.map((step, i) => (
        <li class="relative pl-16 lg:pl-0 lg:pt-20" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <div class="step-node absolute left-0 top-0 flex size-12 items-center justify-center bg-surface text-accent-ink lg:left-0">
            <Icon name={step.icon} class="size-5" />
          </div>
          <p class="font-mono text-xs text-fg-subtle">Langkah {String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-2 font-display text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-fg-muted">{step.desc}</p>
          <p class="mt-4 inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-wider text-accent-ink">
            <Icon name="corner-down-right" class="size-3.5" />{step.output}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .step-node {
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    box-shadow: inset 0 0 0 1px var(--accent);
    background: linear-gradient(var(--surface), var(--surface)) padding-box, var(--accent) border-box;
    border: 1.5px solid transparent;
  }
  /* Garis penghubung: vertikal di mobile, horizontal di desktop */
  .timeline::before {
    content: '';
    position: absolute;
    left: 23px; top: 12px; bottom: 12px; width: 1px;
    background: linear-gradient(var(--accent), var(--border-strong) 30%, var(--border-strong) 70%, transparent);
  }
  @media (min-width: 1024px) {
    .timeline::before { left: 24px; right: 0; top: 24px; bottom: auto; width: auto; height: 1px;
      background: linear-gradient(90deg, var(--accent), var(--border-strong) 30%, var(--border-strong) 80%, transparent); }
  }
</style>
