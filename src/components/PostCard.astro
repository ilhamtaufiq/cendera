---
import { formatDate, postCover, readingTime, type Post } from '@/lib/content';
interface Props { post: Post; headingLevel?: 'h2' | 'h3'; eager?: boolean }
const { post, headingLevel: H = 'h3', eager = false } = Astro.props;
const d = post.data;
const href = `/blog/${post.id}`;
---
<article class="card card-hover group flex h-full flex-col overflow-hidden">
  <img src={postCover(post)} alt="" width="1600" height="900" loading={eager ? 'eager' : 'lazy'} decoding="async"
    class="aspect-[16/9] w-full border-b border-border object-cover transition duration-500 group-hover:scale-[1.02]" />
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center gap-3 text-xs text-fg-subtle">
      <span class="chip chip-accent">{d.category}</span>
      <time datetime={d.date.toISOString()}>{formatDate(d.date, 'short')}</time>
      <span aria-hidden="true">•</span>
      <span>{readingTime(post.body)} menit baca</span>
    </div>
    <H class="mt-4 font-display text-xl font-semibold leading-snug">
      <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">{d.title}</a>
    </H>
    <p class="mt-3 text-[0.95rem] leading-relaxed text-fg-muted line-clamp-3">{d.description}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-5">
      {d.tags.slice(0, 3).map((t) => <li class="font-mono text-xs text-fg-subtle">#{t}</li>)}
    </ul>
  </div>
</article>
<style>
  article:has(h2 a:focus-visible, h3 a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
