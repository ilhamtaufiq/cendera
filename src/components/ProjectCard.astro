---
import Icon from '@/components/ui/Icon.astro';
import { projectSlug, type Project } from '@/lib/content';
interface Props { project: Project; size?: 'lg' | 'md'; headingLevel?: 'h2' | 'h3'; eager?: boolean }
const { project, size = 'md', headingLevel: H = 'h3', eager = false } = Astro.props;
const d = project.data;
const href = `/proyek/${projectSlug(project)}`;
const statusClass = d.status === 'Live' ? 'chip-accent' : '';
---
<article class="card card-hover group flex h-full flex-col overflow-hidden">
  <a href={href} class="relative block overflow-hidden border-b border-border" tabindex="-1" aria-hidden="true">
    <img src={d.cover} alt="" width="1600" height="1000" loading={eager ? 'eager' : 'lazy'} decoding="async"
      class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
    {d.audience && (
      <span class="absolute left-4 top-4 rounded-lg border border-border bg-bg/85 px-2.5 py-1 font-mono text-[0.68rem] uppercase tracking-[0.12em] text-fg backdrop-blur">{d.audience}</span>
    )}
  </a>
  <div class:list={['flex flex-1 flex-col', size === 'lg' ? 'p-7' : 'p-6']}>
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="chip">{d.category}</span>
      <span class:list={['chip', statusClass]}>
        {d.status === 'Live' && <span class="size-1.5 rounded-full bg-accent"></span>}{d.status}
      </span>
      <span class="ml-auto font-mono text-fg-subtle">{d.year}</span>
    </div>
    <H class:list={['mt-4 font-display font-semibold leading-snug', size === 'lg' ? 'text-2xl' : 'text-xl']}>
      <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">{d.title}</a>
    </H>
    <p class="mt-1 text-sm font-medium text-fg-muted">{d.subtitle}</p>
    <p class="mt-3 text-[0.95rem] leading-relaxed text-fg-muted line-clamp-3">{d.summary}</p>
    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Teknologi">
      {d.tech.slice(0, 5).map((t) => <li class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[0.7rem] text-fg-subtle">{t}</li>)}
      {d.tech.length > 5 && <li class="rounded-md px-1 py-0.5 font-mono text-[0.7rem] text-fg-subtle">+{d.tech.length - 5}</li>}
    </ul>
    <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-accent-ink">
      Lihat studi kasus <Icon name="arrow-up-right" class="size-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
    </span>
  </div>
</article>
<style>
  /* Fokus keyboard pada tautan judul (yang menutupi seluruh kartu) */
  article:has(h2 a:focus-visible, h3 a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
