# Variabel BUILD-TIME (dibaca Astro saat `npm run build`). Salin menjadi .env untuk lokal,
# dan isi di Workers Builds → Settings → Build → Variables and secrets untuk produksi.

# URL produksi (canonical, sitemap, RSS, Open Graph)
SITE_URL=https://cendera.id

# Site key Turnstile (publik). Kunci uji ini selalu lolos.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Analitik opsional — isi salah satu:
# Cloudflare Web Analytics
PUBLIC_CF_BEACON_TOKEN=
# Umami (self-host / cloud)
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
